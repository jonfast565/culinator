culinator 0.3;

recipe ck_homemade_rosemary_olive_oil_crackers {
    title "Homemade Rosemary Olive Oil Crackers";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/homemade-rosemary-olive-oil-crackers/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 25 min;
    description "If you're making a charcuterie board, you'll want to bake these Homemade Rosemary Olive Oil Crackers. They're way better than store bought, and they only take about 30 minutes!";

    ingredient ingredient_1 measured by mass {
        name "3/4 cup all purpose flour";
    }

    ingredient ingredient_2 measured by mass {
        name "3/4 cup whole wheat flour";
    }

    ingredient ingredient_3 measured by mass {
        name "1 1/2 teaspoons kosher salt";
    }

    ingredient ingredient_4 measured by mass {
        name "1 1/2 teaspoons sugar";
    }

    ingredient ingredient_5 measured by mass {
        name "1/4 teaspoon garlic powder";
    }

    ingredient ingredient_6 measured by mass {
        name "1 tablespoon finely chopped fresh rosemary";
    }

    ingredient ingredient_7 measured by mass {
        name "3 tablespoons extra virgin olive oil";
    }

    ingredient ingredient_8 measured by mass {
        name "1/2 cup cold water";
    }

    ingredient ingredient_9 measured by mass {
        name "Flaky salt for topping";
    }

    process preparation {
        operation step_1 does prepare {
            note "Preheat oven to 375˚F and line two baking sheets with parchment paper or silpat.";
        }
        operation step_2 does prepare {
            note "Add both flours, salt, sugar, garlic powder, rosemary, olive oil and water to a bowl. Use a fork to mix until a shaggy dough forms, then turn the dough out onto a clean surface.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Knead the dough with your hands for about 5 minutes, until it forms a smooth ball. Divide the dough in half.";
            after step_2;
        }
        operation step_4 does prepare {
            note "Roll out each half into a large rectangle, about 1/16-inch thick (it should be very thin).";
            after step_3;
        }
        operation step_5 does prepare {
            note "Using a fluted pastry cutter (or a knife), cut the crackers into thin rectangles about 6 inches long and 1 1/2 inches wide.";
            after step_4;
        }
        operation step_6 does prepare {
            note "Carefully transfer to the prepared sheet pans. Sprinkle the tops with flaky salt. Bake for 12-15 minutes, until the bottom is golden brown. (The baking length will depend on how thin you rolled your dough).";
            after step_5;
        }
        operation step_7 does prepare {
            note "Let cool completely before enjoying.";
            after step_6;
        }
    }
}
