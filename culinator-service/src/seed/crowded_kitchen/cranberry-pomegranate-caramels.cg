culinator 0.3;

recipe ck_cranberry_pomegranate_caramels {
    title "Cranberry Pomegranate Caramels";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/cranberry-pomegranate-caramels/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 170 min;
    description "These Cranberry Pomegranate Caramels are tart, sweet, chewy and absolutely delicious! The vibrant red color is all-natural, and these make for a fantastic edible holiday gift. (They're also delicious dipped in dark chocolate!)";

    ingredient ingredient_1 measured by mass {
        name "2 cups no sugar added pomegranate juice (freshly squeezed if possible. You'll need 3 large or 4 smaller pomegranates to yield 2 cups of juice)";
    }

    ingredient ingredient_2 measured by mass {
        name "2 cups no sugar added cranberry juice";
    }

    ingredient ingredient_3 measured by mass {
        name "3/4 cup granulated white sugar";
    }

    ingredient ingredient_4 measured by mass {
        name "3/4 cup light brown sugar";
    }

    ingredient ingredient_5 measured by mass {
        name "1 cup unsalted butter, cut into cubes";
    }

    ingredient ingredient_6 measured by mass {
        name "1/3 cup heavy cream";
    }

    ingredient ingredient_7 measured by mass {
        name "2 teaspoons vanilla extract";
    }

    ingredient ingredient_8 measured by mass {
        name "1 teaspoon kosher or sea salt";
    }

    ingredient ingredient_9 measured by mass {
        name "Peel from 1/2 of an orange, pith removed";
    }

    process preparation {
        operation step_1 does prepare {
            note "If making freshly squeezed pomegranate juice: Start by juicing the pomegranates. Add all of the pomegranate arils to a vacuum sealed bag or just a regular zip lock, remove all of the air, and gently roll with a rolling pin until you've \"popped\" all of the arils without crushing the seeds inside. Try to get as much juice out of each aril as possible.";
        }
        operation step_2 does prepare {
            note "Strain the pomegranate arils through a fine mesh sieve. Press down on the arils with the back of a spoon to remove as much juice as possible.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Add the pomegranate juice, cranberry juice, and orange peel to a heavy-bottomed saucepan over medium heat and bring to a light boil, then reduce heat to medium low. The mixture should be gently simmering and it should bubble up a lot when whisked.";
            after step_2;
        }
        operation step_4 does prepare {
            note "Let it reduce until there's about 1/2-3/4 cup of syrup. It's done when you can drag a spatula across the bottom of the pan and the syrup takes a moment to cover the exposed area again. It should be thick and should cover the back of a spoon.";
            after step_3;
        }
        operation step_5 does prepare {
            note "While the syrup is reducing, lightly spray an 8x8\" pan and line with parchment paper. Make sure the parchment paper covers the sides of the pan so the caramel is easy to remove.";
            after step_4;
        }
        operation step_6 does prepare {
            note "Remove the orange peel with tongs, then add in both sugars, butter, and heavy cream. Keep the heat on medium low and stir until everything is melted and the sugar is dissolved. Attach a candy thermometer to the side of the pan and increase the heat to medium. Bring to a boil.";
            after step_5;
        }
        operation step_7 does prepare {
            note "If you want a softer caramel, heat to 245˚F to 250˚F. For a harder caramel, heat to 255˚F to 260˚F (this is what we do). Once it reaches your desired temperature, remove from the heat, then immediately whisk in the vanilla and salt, and carefully pour into the prepared pan.";
            after step_6;
        }
        operation step_8 does prepare {
            note "Place in the refrigerator for about an hour and a half to cool and set. Once the caramels are set, remove the caramels from the pan and place on a cutting board. Keep the parchment underneath the caramels, otherwise if will stick to the cutting board.";
            after step_7;
        }
        operation step_9 does prepare {
            note "Using a knife lightly greased with cooking spray, cut the caramels into roughly 1/2\" x 1 1/2\" rectangles. Wrap the individual caramels in wax paper.";
            after step_8;
        }
    }
}
