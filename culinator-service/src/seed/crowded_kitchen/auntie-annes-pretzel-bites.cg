culinator 0.3;

recipe ck_auntie_annes_pretzel_bites {
    title "Homemade Auntie Anne's Pretzel Bites";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/auntie-annes-pretzel-bites/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 125 min;
    description "Homemade Auntie Anne's Pretzel Bites are the newest addition to our Better Than Store-Bought series. The soft, slightly sweet dough gets a quick baking soda bath and a generous brush of melted butter after baking. Just like the mall classic, they smell as good as they taste. Keep them classic with pretzel salt, or toss them in cinnamon sugar!";

    ingredient ingredient_1 measured by mass {
        name "1 1/2 cups whole milk";
    }

    ingredient ingredient_2 measured by mass {
        name "2 1/4 teaspoons active dry yeast (or instant yeast, 1 packet)";
    }

    ingredient ingredient_3 measured by mass {
        name "1/3 cup brown sugar (packed)";
    }

    ingredient ingredient_4 measured by mass {
        name "3 tablespoons unsalted butter (melted)";
    }

    ingredient ingredient_5 measured by mass {
        name "4 cups all-purpose flour";
    }

    ingredient ingredient_6 measured by mass {
        name "1 teaspoon kosher salt";
    }

    ingredient ingredient_7 measured by mass {
        name "3 cups water";
    }

    ingredient ingredient_8 measured by mass {
        name "1/2 cup baking soda";
    }

    ingredient ingredient_9 measured by mass {
        name "pretzel salt (for sprinkling)";
    }

    ingredient ingredient_10 measured by mass {
        name "1/4 cup butter (melted)";
    }

    ingredient ingredient_11 measured by mass {
        name "1/4 cup granulated sugar";
    }

    ingredient ingredient_12 measured by mass {
        name "1 tablespoon ground cinnamon";
    }

    process preparation {
        operation step_1 does prepare {
            note "Warm the milk in the microwave in 30-second intervals, until it's between 100-110˚F. Stir in the yeast and brown sugar, then let it sit for about 15 minutes, until foamy.";
        }
        operation step_2 does prepare {
            note "To the bowl of a stand mixer fitted with a dough hook, add the flour and salt. Once the yeast has bloomed, whisk the melted butter into the milk mixture. With the mixer running on low, slowly pour the wet ingredients into the flour.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Knead for 10-20 minutes, until the dough is smooth and elastic. (We do about 10 minutes in the mixer and 10 minutes by hand.)";
            after step_2;
        }
        operation step_4 does prepare {
            note "Lightly oil a large bowl, add the dough and turn it to coat. Cover with plastic wrap and let it rise in a warm spot until doubled in size, about 1 hour (or up to 1 ½ hours with active dry yeast).";
            after step_3;
        }
        operation step_5 does prepare {
            note "Preheat the oven to 375˚F. Line a baking sheet with parchment paper and set it on top of a second baking sheet. Doubling the pans keeps the bottoms from getting too brown.";
            after step_4;
        }
        operation step_6 does prepare {
            note "To a medium saucepan, add the water and baking soda. Warm over medium heat until simmering and the baking soda is mostly dissolved, then turn off the heat.";
            after step_5;
        }
        operation step_7 does prepare {
            note "Portion the dough into ~10 pieces. Keep the pieces you're not using covered with a towel. Roll each section into a long rope about ½-inch thick. It should be thinner than you want the finished pretzel bites, since they puff up in the baking soda bath and oven.";
            after step_6;
        }
        operation step_8 does prepare {
            note "Holding the rope over the pot, cut it into 1-inch pieces with kitchen shears, letting them drop right into the baking soda bath. Almost immediately after all of the pretzels are submerged, use a slotted spoon to remove the pretzels from the pot. Shake off the excess liquid and transfer to the prepared baking sheet. Sprinkle with pretzel salt while they're still wet.";
            after step_7;
        }
        operation step_9 does prepare {
            note "Repeat until the first tray is full (about half the dough), then bake for 9-10 minutes, until deep golden brown. While the first tray bakes, roll, cut and dip the remaining dough for the second tray.";
            after step_8;
        }
        operation step_10 does prepare {
            note "As soon as the pretzel bites come out of the oven, brush them generously with melted butter. Enjoy warm!";
            after step_9;
        }
        operation step_11 does prepare {
            note "For cinnamon sugar pretzel bites, skip the pretzel salt. Stir together the sugar and cinnamon, then toss the buttered bites in the mixture while they're still warm, just after they come out of the oven.";
            after step_10;
        }
    }
}
