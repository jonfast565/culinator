culinator 0.3;

recipe ck_homemade_peeps {
    title "Homemade Peeps";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/homemade-peeps/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 360 min;
    description "These homemade marshmallow bunny peeps are so cute, perfect for Easter, and taste SO much better than store bought! They're easy to make and 100% free from corn syrup and artificial dyes.";

    ingredient ingredient_1 measured by mass {
        name "2 packets of unflavored gelatin (4 1/2 teaspoons)";
    }

    ingredient ingredient_2 measured by mass {
        name "3/4 cup cold water, divided";
    }

    ingredient ingredient_3 measured by mass {
        name "3/4 cup granulated sugar";
    }

    ingredient ingredient_4 measured by mass {
        name "1/3 cup honey or agave";
    }

    ingredient ingredient_5 measured by mass {
        name "2 teaspoons vanilla extract (or vanilla bean paste)";
    }

    ingredient ingredient_6 measured by mass {
        name "1/8 teaspoon salt";
    }

    ingredient ingredient_7 measured by mass {
        name "1 teaspoon powdered sugar for dusting pan";
    }

    ingredient ingredient_8 measured by mass {
        name "Naturally colored sanding sugar for coating";
    }

    ingredient ingredient_9 measured by mass {
        name "Optional: melted dark chocolate for eyes and nose";
    }

    ingredient ingredient_10 measured by mass {
        name "Bunny cookie cutter";
    }

    process preparation {
        operation step_1 does prepare {
            note "Spray a quarter baking sheet (~9x13 inch pan) with cooking spray, then line with parchment paper and lightly spray the parchment paper. Dust with 1 tsp powdered sugar and set aside. Grease a regular spatula and an offset spatula and set aside.";
        }
        operation step_2 does prepare {
            note "Add the gelatin to a stand mixer with 1/2 cup of cold water, stir gently and let sit to bloom for 10 minutes while you make the simple syrup.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Add the remaining 1/4 cup of water, the sugar, and the honey to a small saucepan over medium heat. Stir the mixture constantly until the sugar dissolves, then stop stirring and clip a candy thermometer to the side of the pan. Cook without stirring until the thermometer reads 240°F.";
            after step_2;
        }
        operation step_4 does prepare {
            note "Remove from heat, let the bubbling subside for a few seconds, then turn the mixer on low speed while you carefully pour the sugar syrup into the gelatin, pouring the hot syrup down the side of the bowl to prevent scorching the gelatin. Beat on low for 1 minute, then increase speed to high and beat for ~10-12 minutes, until thick and fluffy. It should increase 3x in volume. Add in vanilla and salt and continue mixing for 2 minutes.";
            after step_3;
        }
        operation step_5 does prepare {
            note "Immediately transfer marshmallow mixture to prepared pan and spread into a smooth, even layer. Let sit at room temperature for 6-12 hours to set.";
            after step_4;
        }
        operation step_6 does prepare {
            note "Grease the cookie cutter before cutting into bunny shapes. You should be able to get ~36-40 marshmallows. Coat in colored sugar and (optional) pipe melted dark chocolate for the eyes and nose.";
            after step_5;
        }
    }
}
