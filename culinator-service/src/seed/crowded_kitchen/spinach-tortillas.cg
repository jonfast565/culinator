culinator 0.3;

recipe ck_spinach_tortillas {
    title "Spinach Tortillas";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/spinach-tortillas/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 45 min;
    description "You only need 5 ingredients to make a batch of these easy and delicious spinach tortillas. They're soft, flexible and slightly chewy, and they're perfect for tacos, wraps, quesadillas, and more. This recipe is a great way to get in an extra serving of veggies, and it only takes a few minutes of hands on work to make a big batch!";

    ingredient ingredient_1 measured by mass {
        name "3/4 cup warm water";
    }

    ingredient ingredient_2 measured by mass {
        name "2 cups baby spinach, lightly packed";
    }

    ingredient ingredient_3 measured by mass {
        name "3 cups all-purpose flour";
    }

    ingredient ingredient_4 measured by mass {
        name "1 teaspoon baking powder";
    }

    ingredient ingredient_5 measured by mass {
        name "1 teaspoon kosher salt";
    }

    ingredient ingredient_6 measured by mass {
        name "1/3 cup olive oil";
    }

    process preparation {
        operation step_1 does prepare {
            note "To a bullet blender or food processor, add the spinach and warm water, and blend until no pieces of spinach remain.";
        }
        operation step_2 does prepare {
            note "To a large mixing bowl, add the flour, baking powder, and salt and whisk to combine.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Add in the olive oil and blended spinach mixture and stir until a shaggy dough forms.";
            after step_2;
        }
        operation step_4 does prepare {
            note "Turn the dough out onto a floured work surface, and knead for a minute or two until you have a smooth, streak-free dough.";
            after step_3;
        }
        operation step_5 does prepare {
            note "Use a bench scraper or a knife to cut the dough into 16 even portions. Make sure they're not touching one another and cover with a kitchen towel or plastic wrap.";
            after step_4;
        }
        operation step_6 does prepare {
            note "Let the dough sit for 15-20 minutes.";
            after step_5;
        }
        operation step_7 does prepare {
            note "Take each portion of dough and form it into a small disc, then move to a nonstick pastry mat or other nonstick work surface, and use a rolling pin to roll the dough into a tortilla. Each tortilla should be about 7-9\" in diameter, and should be thin enough that you can see your hand through the bottom of them.";
            after step_6;
        }
        operation step_8 does prepare {
            note "Heat a nonstick pan over medium heat to medium-high heat and carefully transfer your tortilla to the pan. Cook for 3-5 minutes, until the tortilla starts to puff a bit and there are a few brown spots on the underside of the tortilla, then flip and cook for another 3-5 minutes. Repeat with the rest of the tortillas.";
            after step_7;
        }
    }
}
