culinator 0.3;

recipe ck_homemade_cosmic_brownies {
    title "Cosmic Brownies";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/homemade-cosmic-brownies/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 135 min;
    description "These homemade cosmic brownies are a copycat version of one of our favorite childhood treats as part of our Better Than Store-Bought series! Dense, fudgy brownies are topped with a silky smooth ganache and sprinkled with those trademark multicolored sprinkles.";

    ingredient ingredient_1 measured by mass {
        name "8 tablespoons 1/2 cup unsalted butter";
    }

    ingredient ingredient_2 measured by mass {
        name "6 oz semisweet chocolate (chopped)";
    }

    ingredient ingredient_3 measured by mass {
        name "1¼ cups granulated sugar";
    }

    ingredient ingredient_4 measured by mass {
        name "2 whole eggs + 1 egg yolk";
    }

    ingredient ingredient_5 measured by mass {
        name "2 teaspoons vanilla extract";
    }

    ingredient ingredient_6 measured by mass {
        name "¼ cup Dutch process cocoa powder";
    }

    ingredient ingredient_7 measured by mass {
        name "⅔ cup all purpose flour";
    }

    ingredient ingredient_8 measured by mass {
        name "½ teaspoon salt";
    }

    ingredient ingredient_9 measured by mass {
        name "3/4 cup semisweet chocolate (chopped)";
    }

    ingredient ingredient_10 measured by mass {
        name "6 tablespoons heavy cream";
    }

    ingredient ingredient_11 measured by mass {
        name "Cosmic brownie sprinkles";
    }

    process preparation {
        operation step_1 does prepare {
            note "Preheat the oven to 325°F and line an 8x8-inch square baking pan with parchment paper, leaving an overhang on two sides for easy removal.";
        }
        operation step_2 does prepare {
            note "To a saucepan over low heat, add the butter and heat until melted. Then add in the 6 ounces of chopped bittersweet chocolate, stirring frequently, until melted, then turn off the heat.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Whisk the sugar into the warm butter/chocolate mixture for 1 to 2 minutes, until the mixture is glossy and well combined. Whisk in the eggs one at a time, followed by the egg yolk and vanilla extract, mixing until the batter is smooth and slightly thickened.";
            after step_2;
        }
        operation step_4 does prepare {
            note "To a separate medium-sized mixing bowl, combine the cocoa powder, flour, and salt and whisk until evenly incorporated. Fold this dry mixture into the wet chocolate butter mixture in 3 batches until no dry streaks remain.";
            after step_3;
        }
        operation step_5 does prepare {
            note "Pour out and spread the batter evenly into the prepared pan.";
            after step_4;
        }
        operation step_6 does prepare {
            note "Bake for 24 to 28 minutes, or until the edges are set and a toothpick inserted into the center comes out with some moist crumbs attached.";
            after step_5;
        }
        operation step_7 does prepare {
            note "Let the brownies cool completely in the pan.";
            after step_6;
        }
        operation step_8 does prepare {
            note "To make the ganache, heat the heavy cream in a small saucepan over low heat until steaming, but not boiling. Pour the heavy cream over the chopped chocolate in a heat safe bowl. Let it sit for 1-2 minutes, then whisk until the chocolate is fully melted. If it's not fully melted, microwave for about 5-7 seconds until fully melted.";
            after step_7;
        }
        operation step_9 does prepare {
            note "Pour the ganache on top of the cooled brownies and spread into an even layer. Top with sprinkles, then let the ganache set before slicing.";
            after step_8;
        }
    }
}
