culinator 0.3;

recipe ck_strawberry_poppyseed_salad {
    title "Copycat Strawberry Poppyseed Salad (Just like Panera!)";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/strawberry-poppyseed-salad/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 30 min;
    description "Our Strawberry Poppyseed Salad is a copycat recipe of the popular Panera favorite. It's filled with the usual staples: chopped romaine, fresh blueberries, strawberries, mandarin oranges, diced chicken, and pecans. Then, it's topped with our homemade poppyseed dressing.";

    ingredient ingredient_1 measured by mass {
        name "¼ cup extra virgin olive oil";
    }

    ingredient ingredient_2 measured by mass {
        name "2 tablespoons plain greek yogurt";
    }

    ingredient ingredient_3 measured by mass {
        name "1 tablespoon white wine vinegar or champagne vinegar";
    }

    ingredient ingredient_4 measured by mass {
        name "1 tablespoon mandarin orange juice";
    }

    ingredient ingredient_5 measured by mass {
        name "2 teaspoons honey";
    }

    ingredient ingredient_6 measured by mass {
        name "½ teaspoon kosher salt";
    }

    ingredient ingredient_7 measured by mass {
        name "½ teaspoon ground mustard powder";
    }

    ingredient ingredient_8 measured by mass {
        name "½ teaspoon onion powder";
    }

    ingredient ingredient_9 measured by mass {
        name "2 teaspoons poppy seeds";
    }

    ingredient ingredient_10 measured by mass {
        name "4 cups (packed) chopped romaine or 5 cups loosely packed (2 small-medium heads of romaine)";
    }

    ingredient ingredient_11 measured by mass {
        name "¾ cup fresh blueberries";
    }

    ingredient ingredient_12 measured by mass {
        name "1 cup fresh sliced strawberries";
    }

    ingredient ingredient_13 measured by mass {
        name "½ cup mandarin oranges (2 small mandarins)";
    }

    ingredient ingredient_14 measured by mass {
        name "½ cup toasted pecans";
    }

    ingredient ingredient_15 measured by mass {
        name "2 grilled chicken breasts, diced";
    }

    ingredient ingredient_16 measured by mass {
        name "1/2 cup feta cheese";
    }

    ingredient ingredient_17 measured by mass {
        name "1 small avocado, diced";
    }

    process preparation {
        operation step_1 does prepare {
            note "Make the dressing by combining all dressing ingredients in a small bowl. Whisk to combine. Set aside.";
        }
        operation step_2 does prepare {
            note "To make the salad, prep all of the ingredients. Add romaine lettuce to a large bowl or serving platter. Evenly top the lettuce with the remaining ingredients.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Drizzle poppyseed dressing over top and toss to coat.";
            after step_2;
        }
    }
}
