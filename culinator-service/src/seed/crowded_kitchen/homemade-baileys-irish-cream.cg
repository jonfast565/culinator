culinator 0.3;

recipe ck_homemade_baileys_irish_cream {
    title "Homemade Baileys Irish Cream";
    section "Better Than Store Bought";
    source "Crowded Kitchen";
    publisher "Crowded Kitchen";
    source_url "https://www.crowdedkitchen.com/homemade-baileys-irish-cream/";
    attribution "Recipe by Crowded Kitchen. See source URL for the original and updates.";
    total_time 15 min;
    description "This Homemade Baileys Irish Cream is rich, sweet, absolutely delicious and perfect for a DIY holiday gift that comes together in just a few minutes! Add it to your favorite cocktails, or add a splash into your coffee for a boozy kick.";

    ingredient ingredient_1 measured by mass {
        name "1 1/2 cups heavy cream";
    }

    ingredient ingredient_2 measured by mass {
        name "1 cup whole milk";
    }

    ingredient ingredient_3 measured by mass {
        name "1 teaspoon cocoa powder";
    }

    ingredient ingredient_4 measured by mass {
        name "1 teaspoon instant espresso powder (optional)";
    }

    ingredient ingredient_5 measured by mass {
        name "1/2 cup granulated sugar";
    }

    ingredient ingredient_6 measured by mass {
        name "1/3 cup maple syrup";
    }

    ingredient ingredient_7 measured by mass {
        name "1 1/2 teaspoons vanilla extract";
    }

    ingredient ingredient_8 measured by mass {
        name "1 cup Irish whiskey";
    }

    process preparation {
        operation step_1 does prepare {
            note "Add all ingredients except for the whiskey to a pot over medium-low heat.";
        }
        operation step_2 does prepare {
            note "Heat the mixture, whisking until the sugar is dissolved and the cocoa powder is well incorporated. The mixture should be steaming hot, but it should not simmer or boil. Keep over medium-low heat for a few minutes, then remove from heat.";
            after step_1;
        }
        operation step_3 does prepare {
            note "Let it cool to room temperature, then whisk in the Irish whiskey.";
            after step_2;
        }
        operation step_4 does prepare {
            note "Transfer to a jar or glass bottles with a lid, then store in the refrigerator for 1-2 months. Shake well before each use.";
            after step_3;
        }
    }
}
